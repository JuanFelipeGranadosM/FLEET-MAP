FLEETMAP_PROVIDER=mock
FLEETMAP_CORS_ORIGINS=["http://localhost:5173"]
# Libro de arranque diario (40BU) como fuente:
# FLEETMAP_PROVIDER=excel
# FLEETMAP_EXCEL_PATH=C:/Users/<usuario>/Downloads/ARRANQUE DIARIO DE EQUIPOS.xlsx
# FLEETMAP_SITES_PATH=sites.json

# Para datos reales:
# FLEETMAP_PROVIDER=aemp
# FLEETMAP_AEMP_BASE_URL=https://<oem>/aemp/v2
# FLEETMAP_AEMP_TOKEN_URL=https://<oem>/oauth/token
# FLEETMAP_AEMP_CLIENT_ID=
# FLEETMAP_AEMP_CLIENT_SECRET=
# FLEETMAP_ASSET_MASTER_PATH=asset_master.json

# Facturación (repercusión, tarifas, actas): PostgreSQL de docker compose con los esquemas de db/
# FLEETMAP_DATABASE_URL=postgresql://fleetmap:fleetmap@localhost:5432/fleetmap
