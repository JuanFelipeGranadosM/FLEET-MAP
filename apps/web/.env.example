# Estilo del mapa base oscuro (MapLibre). Cualquier style.json compatible sirve (MapTiler, Stadia, propio…).
VITE_MAP_STYLE_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
# Teselas raster satelitales ({z}/{y}/{x} o {z}/{x}/{y} según el proveedor). Revisar los términos de uso del proveedor.
VITE_MAP_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# URL base de la API (vacío = mismo origen, con el proxy de Vite en desarrollo)
VITE_API_URL=
